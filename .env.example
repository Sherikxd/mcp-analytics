# Supabase (público: se usa en servidor para las consultas)
NEXT_PUBLIC_SUPABASE_URL=https://mdkyrtrzsptkjwuqrwgf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (opcional, SOLO servidor - jamás exponer en cliente)
